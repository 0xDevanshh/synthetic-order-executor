{
  "name": "@soe/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "hardhat compile",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "test:fork": "FORK=1 hardhat test test/SyntheticOrderExecutor.fork.test.ts",
    "coverage": "hardhat coverage",
    "typecheck": "tsc --noEmit",
    "node": "hardhat node",
    "deploy:local": "hardhat run script/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run script/deploy.ts --network sepolia",
    "configure:sepolia": "hardhat run script/configure.ts --network sepolia",
    "verify:sepolia": "hardhat run script/verify.ts --network sepolia",
    "abi:export": "hardhat run script/exportAbi.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.15",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.13",
    "typescript": "^5.6.3",
    "viem": "^2.21.40"
  }
}
