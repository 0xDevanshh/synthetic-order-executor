// Neon serverless PostgreSQL.
//   DATABASE_URL        -> pooled connection (PgBouncer), used by the apps
//   DIRECT_DATABASE_URL -> direct connection, required for migrations
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum OrderStatus {
  PENDING
  TRIGGERED
  EXECUTING
  EXECUTED
  FAILED
  CANCELLED
}

enum OrderSide {
  BUY
  SELL
}

model Order {
  id String @id

  /// Checksummed EVM address of the order owner. Also the `owner` argument
  /// passed to SyntheticOrderExecutor.executeSwap, so the contract debits and
  /// credits the right vault balance.
  userAddress String

  /// Token symbols as the API speaks them ("ETH", "USDC"). Resolved to
  /// addresses and decimals at execution time via the token registry, so a
  /// redeployment to different token addresses does not rewrite stored orders.
  tokenIn  String
  tokenOut String

  side OrderSide

  /// Human-readable units, e.g. "0.01" ETH. Converted to base units only when
  /// building calldata. Decimal, never float — a float cannot hold 0.1 exactly
  /// and this value is what the user is committing funds against.
  amount Decimal @db.Decimal(38, 18)

  /// Trigger threshold in USD, e.g. "3500".
  triggerPrice Decimal @db.Decimal(38, 18)

  status OrderStatus @default(PENDING)

  /// bytes32 passed to the contract. Derived deterministically from the order
  /// id at creation, so a retry of the same order can never execute twice:
  /// the contract rejects a repeated executionId regardless of what the
  /// backend believes.
  executionId String @unique

  txHash       String? @unique
  errorMessage String?

  /// Optimistic-lock version. The claim that moves an order into EXECUTING is a
  /// single conditional UPDATE on (status, version), so two concurrent workers
  /// cannot both claim the same order.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Serves the price-watcher's future hot query: find PENDING orders whose
  /// trigger the latest price satisfies.
  @@index([status, triggerPrice])
  @@index([userAddress, status])
  @@index([status, createdAt])
  @@map("orders")
}
