// Neon serverless PostgreSQL.
//   DATABASE_URL        -> pooled connection (PgBouncer), used by the apps
//   DIRECT_DATABASE_URL -> direct connection, required for migrations
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

/// Last block scanned for SwapExecuted logs.
///
/// Single row (id = "default"). The reconciler always re-scans the last
/// REORG_BUFFER_BLOCKS before this point, because a block that was canonical on
/// the previous pass may not be on this one.
model IndexerCheckpoint {
  id                 String   @id @default("default")
  lastProcessedBlock BigInt
  updatedAt          DateTime @updatedAt

  @@map("indexer_checkpoints")
}

/// Every correction the reconciler makes, and every discrepancy it declines to
/// auto-correct.
///
/// Silent self-healing destroys the ability to debug an execution engine: if
/// the database quietly repairs itself, nobody ever learns which code path was
/// wrong. Every write here is a signal that something upstream misbehaved.
model ReconciliationLog {
  id      String  @id @default(uuid())
  orderId String?
  /// STUCK_EXECUTING | LOG_BACKFILL | FAILED_BUT_EXECUTED | EXECUTED_NO_EVIDENCE
  kind    String
  /// What the database claimed versus what the chain said.
  discrepancy String
  /// What was done about it, including "logged only, not auto-corrected".
  resolution  String
  txHash      String?
  blockNumber BigInt?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([kind, createdAt])
  @@map("reconciliation_logs")
}

enum OrderStatus {
  PENDING
  TRIGGERED
  EXECUTING
  EXECUTED
  FAILED
  CANCELLED
}

enum OrderSide {
  BUY
  SELL
}

model Order {
  id String @id

  /// Checksummed EVM address of the order owner. Also the `owner` argument
  /// passed to SyntheticOrderExecutor.executeSwap, so the contract debits and
  /// credits the right vault balance.
  userAddress String

  /// Token symbols as the API speaks them ("ETH", "USDC"). Resolved to
  /// addresses and decimals at execution time via the token registry, so a
  /// redeployment to different token addresses does not rewrite stored orders.
  tokenIn  String
  tokenOut String

  side OrderSide

  /// Human-readable units, e.g. "0.01" ETH. Converted to base units only when
  /// building calldata. Decimal, never float — a float cannot hold 0.1 exactly
  /// and this value is what the user is committing funds against.
  amount Decimal @db.Decimal(38, 18)

  /// Trigger threshold in USD, e.g. "3500".
  triggerPrice Decimal @db.Decimal(38, 18)

  status OrderStatus @default(PENDING)

  /// bytes32 passed to the contract. Derived deterministically from the order
  /// id at creation, so a retry of the same order can never execute twice:
  /// the contract rejects a repeated executionId regardless of what the
  /// backend believes.
  executionId String @unique

  txHash       String? @unique
  errorMessage String?

  /// When the signed transaction was recorded, immediately BEFORE broadcast.
  /// Its presence means "a transaction may exist on-chain for this order" — the
  /// monitor treats that as the point of no return for blind retries.
  submittedAt DateTime?
  /// When a receipt was observed and the order reached a terminal state.
  confirmedAt DateTime?

  blockNumber BigInt?
  gasUsed     BigInt?
  /// Actual output, decoded from the SwapExecuted event. Not the quote.
  amountOut   Decimal? @db.Decimal(78, 0)

  /// How many times the MONITOR has polled. Distinct from execution attempts:
  /// polling is a read and always safe, resubmitting is not.
  monitorAttempts Int @default(0)

  /// Optimistic-lock version. The claim that moves an order into EXECUTING is a
  /// single conditional UPDATE on (status, version), so two concurrent workers
  /// cannot both claim the same order.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Serves the price-watcher's future hot query: find PENDING orders whose
  /// trigger the latest price satisfies.
  @@index([status, triggerPrice])
  @@index([userAddress, status])
  @@index([status, createdAt])
  /// Serves the monitor's sweep for orders stuck in EXECUTING.
  @@index([status, submittedAt])
  @@map("orders")
}
